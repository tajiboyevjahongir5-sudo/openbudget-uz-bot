# Bot sozlamalari namunasi
# Bu faylni nusxalab .env nomi bilan saqlang, keyin to'ldiring
# Haqiqiy .env faylini hech qachon GitHub'ga yuklamang!

# ============================================================
# Majburiy sozlamalar
# ============================================================

# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=your_telegram_bot_token_here

# Sizning Telegram ID raqamingiz (admin)
# ID olish uchun @userinfobot ga /start yuboring
ADMIN_ID=your_telegram_id_here

# ============================================================
# API sozlamalari
# ============================================================

# Asosiy API server manzili (o'zgartirmang)
API_URL=https://openbudjet-production.up.railway.app/api/v1

# API kalitingiz (@Budjetuz2026_Bot dan xarid qilinadi)
# Bot ichidan ham /admin → "🔑 API Kalitni ulash" orqali kiritish mumkin
API_KEY=

# ============================================================
# Ma'lumotlar bazasi
# ============================================================

# SQLite fayl yo'li
# Railway.app uchun: /data/client_bot.db (Volume kerak)
# Lokal uchun: client_bot.db
DATABASE_PATH=client_bot.db
